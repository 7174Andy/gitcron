# Copy this file to .env.local for local development:
#
#     cp .env.example .env.local
#
# Next.js loads .env.local ahead of .env, so your local values win without
# touching any shared .env file. Both are gitignored.

# ---------------------------------------------------------------------------
# GitHub OAuth App
# ---------------------------------------------------------------------------
# A GitHub OAuth App allows exactly ONE authorization callback URL, so local
# development needs its own app -- the deployed app's credentials cannot also
# serve localhost. Create a second app at https://github.com/settings/developers
#
#   Application name: GitCron (dev)
#   Homepage URL:     http://localhost:3000
#   Callback URL:     http://localhost:3000/api/auth/callback/github
#
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Do NOT set AUTH_URL for local development. Auth.js infers the origin from the
# incoming request and already trusts the host whenever NODE_ENV is not
# "production". Setting it rewrites the request origin, so a value copied from
# production (https://your-app.vercel.app) silently breaks localhost sign-in.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Use a database you can throw away -- signing in locally and scheduling a
# workflow writes real rows.
# Local:      postgresql://user:password@localhost:5432/gitcron
# Production: your cloud provider's connection string
DATABASE_URL=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Authenticates calls to /api/cron/execute.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Encrypts stored GitHub access tokens (32 bytes, base64 encoded).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Stored tokens are only readable with the key that encrypted them, so a
# database shared with another environment needs that environment's key.
ENCRYPTION_KEY=
