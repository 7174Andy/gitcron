# Copy this file to .env.local for local development:
#
#     cp .env.example .env.local
#
# Keep local development in .env.local and leave .env out of it entirely.
# Production values belong in the Vercel dashboard; nothing on a development
# machine should be a production credential.
#
# Why not split them across the two files: the Prisma CLI reads only .env and
# has no knowledge of .env.local, so a DATABASE_URL in .env.local is invisible
# to `prisma db push` -- which would then quietly use whatever .env holds. The
# npm run db:* scripts go through scripts/prisma.mjs, which loads .env.local
# first and refuses to touch the production database. A bare `npx prisma ...`
# does not, so prefer the scripts, and keep no production DATABASE_URL in .env
# for a stray command to find.

# ---------------------------------------------------------------------------
# GitHub OAuth App
# ---------------------------------------------------------------------------
# A GitHub OAuth App allows exactly ONE authorization callback URL, so local
# development needs its own app -- the deployed app's credentials cannot also
# serve localhost. Create a second app at https://github.com/settings/developers
#
#   Application name: GitCron (dev)
#   Homepage URL:     http://localhost:3000
#   Callback URL:     http://localhost:3000/api/auth/callback/github
#
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Do NOT set AUTH_URL for local development. Auth.js infers the origin from the
# incoming request and already trusts the host whenever NODE_ENV is not
# "production". Setting it rewrites the request origin, so a value copied from
# production (https://your-app.vercel.app) silently breaks localhost sign-in.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Never point this at production. A schedule is a row, and the deployed cron
# executes every due row it finds -- so a test schedule created here would
# dispatch a real workflow against a real repository, with nothing on this
# machine to show it happened. The server refuses to start if it recognises the
# production database, and so do the db:* scripts; set ALLOW_REMOTE_DB=1 if you
# truly mean it.
#
# Either a development database from https://console.prisma.io:
#   postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require
#
# Or a local one (npm run db:up starts it, npm run db:push applies the schema):
#   postgresql://postgres:dev@localhost:5433/gitcron_dev
DATABASE_URL=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Authenticates calls to /api/cron/execute.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Encrypts stored GitHub access tokens (32 bytes, base64 encoded).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Generate a fresh one for development. Stored tokens are only readable with the
# key that encrypted them, so reusing a database across environments requires
# that environment's key too.
ENCRYPTION_KEY=
